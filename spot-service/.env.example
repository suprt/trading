# ─── GRPC ───
GRPC_ADDR=:50052
GRPC_STOP_TIMEOUT=15s

# ─── POSTGRES ───
POSTGRES_DSN=postgres://trading:trading@localhost:5433/spot_db?sslmode=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5
POSTGRES_MAX_CONN_LIFETIME=5m
POSTGRES_MAX_CONN_IDLE_TIME=1m

# ─── REDIS ───
REDIS_ADDR=redis:6379
# REDIS_ADDR=localhost:6379
REDIS_USER=redis_user
REDIS_PASSWORD=redis_password
REDIS_DB=0

#  ─── INTERNAL ───
USER_SERVICE_ADDR=localhost:50051
INTERNAL_SECRET=dev-internal-secret

# ─── CACHE ───
CACHE_MARKETS_TTL=24h

# ─── LOG ───
LOG_LEVEL=debug
LOG_FORMAT=console

# ─── CONFIG PATH ───
CONFIG_YAML_PATH=config.yaml

# ─── JWT ───
JWT_SECRET=dev-secret